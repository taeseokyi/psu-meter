// ============================================================================
//  psu-meter — 1단계(수동) 측정 헤드 · 인쇄 부품
//  같이 볼 것: ../docs/head.html (도면·3D·이 상수를 뽑아 준다) · ../HOBBY_BUILD.md
//
//  2026-09-02 전면 재작성 — **허브 일체형**.
//  덕트·접착 패드·착탈 칼라·거울이 전부 없어졌습니다. 프리즘 포켓 · 관통 채널 ·
//  인쇄 조리개 · 조명 플러그 소켓 · 칩 포켓이 **본체 한 부품** 안에 있습니다.
//
//  치수는 docs/head.html 의 광선추적 계산값입니다. 실물 제작·측정은 아직 없습니다.
//
//  좌표계 : 측정점 M = 원점
//           +X = 프리즘 현(60 mm) 방향
//           +Y = 프리즘 두께 방향.  Y=0 이 입사면 = 클램셸 분할면
//           +Z = 위(시료 쪽).  유리는 Z<0
//
//  ── 반드시 알고 볼 것 ────────────────────────────────────────────────────
//  ★★ 기계 팔과 **광학 지렛대**는 다릅니다 (2026-09-02 정정).
//    기계 팔(ARM_I/ARM_D)은 곡면 통과점 E 에서 재고, 부품을 놓는 자리를 정합니다.
//    광학 지렛대(LEVER)는 **측정점 M** 에서 잽니다 — 반원은 곡면 굴절이 없어
//    광선이 M 을 지나는 하나의 직선이라 프리즘 반지름이 지렛대에 포함됩니다.
//    LEVER = E·주광선(=R=30) + ARM_D(60) = 90.  전에는 60 으로 계산해
//    스팬·조리개가 전부 틀렸습니다.
//
//  ★ 팔 길이는 **곡면 통과점 E** 에서 잽니다. 프리즘 중심이 아닙니다.
//    반원이라 주광선이 곡면을 0°로 지나므로 방향은 M 에서 나온 것과 같지만,
//    기준점은 E(26.87, -13.34) 입니다. 조명팔 40 의 끝은 중심에서 70 mm 입니다.
//
//  ★ 주광선은 **17.5 PSU(보정 범위의 한가운데)** 에 조준합니다 — 수조 염도(34)가
//    아닙니다. 34 에 조준하면 2점 보정에 필요한 0~35 PSU 가 조명 부채꼴의
//    아래쪽 끝에 몰려 RO-DI(0 PSU) 여유가 0.046° 밖에 안 남습니다.
//    17.5 조준이면 양쪽 0.30° 로 균형이 잡힙니다.
//
//  ★ 블록 깊이 HUB_Z 는 **프리즘이 아니라 내려가는 팔**이 정합니다.
//    팔이 26.41° 아래로 가므로 팔 끝(칩·플러그)이 프리즘 바닥보다 훨씬 깊습니다.
//    옛 식 ceil(사지타 + 2*벽 + 5) = 42 를 쓰면 검출 채널이 L=59.8 에서 블록
//    바닥을 뚫고 나가고 칩이 바로 L=60 입니다. head.html 의 "블록 깊이 검사" 행이
//    이것을 판정합니다. 형상을 바꾸면 그 표를 다시 보십시오.
//
//  ★ 정밀해야 하는 것은 딱 하나 — **두 팔이 서로 움직이지 않는 것**입니다.
//    그래서 본체를 한 몸으로 인쇄하고, 분할면(Y=0)을 바닥에 놓습니다.
// ============================================================================

/* [부품 선택] */
// OpenSCAD 의 Window > Customizer 를 켜면 아래가 드롭다운으로 나옵니다.
// 고르고 F5(미리보기) / F6(렌더) / F7(STL 내보내기).
PART = "preview"; // [preview:조립 미리보기 (인쇄용 아님), load:★ B 에 부품 얹는 자리 (조립 설명), hub_a:본체 반쪽 A (Y<0) — 분할면을 바닥에, hub_b:본체 반쪽 B (Y>0), base:받침대 — 바닥판+홈턱+M4 3점, lid:뚜껑 (작은 판+힌지), slit_plug:조명측 플러그, slit_plate:★ 갈아 끼우는 슬릿판, section:분할면 단면 (검증용), fitcheck:닫힘 간섭 (비어야 정상), swingcheck:여닫는 동안 간섭 (비어야 정상), thincheck:얇은 살 검사, prismcheck:프리즘 간섭, plugcheck:플러그 간섭, platecheck:슬릿판 간섭 (모두 비어야 정상), raycheck:플러그 광로 관통 (비어야 정상)]

/* [Hidden] */

$fn = 180;

// ============================================================================
//  상수 — docs/head.html "SCAD 상수" 블록을 그대로 덮어쓰면 된다
// ============================================================================
// ── 프리즘 ─────────────────────────────────────
P_CHORD = 60;
P_SAG   = 30;
P_THICK = 10;      // 실물 도착하면 실측
FIT     = 0.35;
P_R     = 30.0000;
P_CZ    = 0.0000;
//  ★★ 2026-09-04 발견 — **포켓이 프리즘을 FIT 만큼 떨어뜨리고 있었다.**
//    포켓은 반지름 P_R+FIT 의 원통이고 중심이 z=0 이었다. 그 안에 실물(반지름 P_R)이
//    중력으로 앉으면 중심이 z=-FIT 로 내려간다 — 측정면이 설계 평면보다 0.35 mm
//    아래다. 결과가 둘이다 :
//      (1) "창 밖 살이 프리즘을 위에서 물어 준다"는 전제가 **사실이 아니었다.**
//          살과 프리즘 사이에 0.35 mm 가 통째로 비어 있었다. 실링의 기준면이 없다.
//      (2) 광선이 프리즘 중심을 0.35 빗나가 곡면 입사각 0.668°, 굴절 편향 0.220°.
//          조명 부채꼴 여유가 편측 0.30° 다. 2점 보정이 상수로 흡수하긴 하지만
//          여유의 3분의 2를 그냥 먹는다.
//    포켓 원통만 FIT-P_SEAT 만큼 **올려서** 앉는 자리를 정한다. 남기는 P_SEAT 은
//    프리즘 반지름 공차를 먹는 몫이다 — 0 으로 하면 실물이 조금만 커도 프리즘이
//    포켓 바닥과 살 사이에 끼여 응력을 받는다 (HANDOFF 의 금기).
P_SEAT  = 0.15;    // 앉았을 때 프리즘 상면이 z=0 보다 내려가는 양 (= 살과의 틈)

// ── 광학 ───────────────────────────────────────
ARM_DEG = 26.4114;  // ★ 주광선 조준 17.5 PSU (보정범위 중앙). 34 조준이면 26.1525
EXIT_X  = 26.8687;
EXIT_Z  = -13.3444;
WIN_Z   = 5.0;      // ★ 추적한 최대 빔 폭 + 0.6. 공식 아님 (2026-09-02 정정)
LEVER   = 90.0;     // 광학 지렛대 (M 기준) = E·주광선 30 + 기계팔 60
ARM_I   = 40;       // 조명팔 — 끝이 슬릿
ARM_D   = 60;       // 검출팔 — 끝이 칩
REACH_I = 61;       // 조명측 부품 적재 총 도달
REACH_D = 72;       // 검출측
STOPS_I = [[13.6,2.86],[24.8,1.98],[35.2,1.17]];   // 슬릿에서 퍼진다 — 팔 끝이 가장 좁다
STOPS_D = [[52.8,2.74]];    // ★ 한 자리뿐. 검출측 빔은 프리즘 쪽이 넓어
                            //   나머지 자리는 어깨 1 mm 를 못 남긴다 (채널 자체가 조리개)

// ── 부품 ───────────────────────────────────────
CHIP_L = 9.4; CHIP_W = 3; CHIP_H = 1.2;   // TSL1401CL CL 패키지
LED_D  = 5.25;
PLUG_W = 10; PLUG_Y = 10; PLUG_L = 20;   // 조명측 플러그

// ── 블록 ───────────────────────────────────────
HUB_TOP = 3;
HUB_L   = 93; HUB_R = 103;
// ── 측정창 · 실링 (2026-09-02 신설 → 2026-09-04 실링 개정) ────────────
//  ★ 프리즘 상부를 x 로는 **필요한 만큼만** 연다. 조명 패치가 8.6 mm 이므로 14 면 된다.
//  ★ 창을 **사면**으로 판다. 뚜껑 보스가 그 사면에 **선으로 걸려** 스스로 중심을
//    잡고, SEAT 만큼 떠서 액적을 누르지 않는다. 직각 면이면 자기정렬이 없다.
//    보스 사면을 창보다 **완만하게**(12° vs 25°) 해서 아래 모서리만 닿게 한다.
//  ★ 밀폐가 중요하다 — 0.15 mm 틈만 있어도 둘레 확산으로 분당 0.4 PSU 가 샌다.
//
//  ★★ 2026-09-04 실링 개정 — **덮는 것은 막는 것이 아니다.**
//    옛 값 WIN_HY = 4 는 프리즘(반두께 5) 위에 편측 1 mm 의 살을 남겨 포켓 틈을
//    "덮게" 했다. 그런데 (가) 포켓이 프리즘을 0.35 떨어뜨려 그 살은 애초에 프리즘에
//    닿지도 않았고(P_SEAT 주석), (나) 닿았더라도 살 밑 0.05 mm 틈은 모세관압이
//    +1 kPa (2γcosθ/h, PETG θ≈70°)라 액을 **빨아들인다**.
//    그렇게 빨린 액은 닦이지도 마르지도 않아 표준액↔시료 **이월**이 된다.
//    20 µL 중 몇 µL 만 이월돼도 35 와 34 사이에서 0.1 PSU 급이다 — 예산 전체(0.066)
//    보다 크다. 광학·기구 어떤 개선보다 크다.
//    그래서 방침을 바꿨다 : **면끼리 맞물리게 하지 않는다.** 창을 프리즘 전폭까지
//    열고, 옆 틈과 살 밑을 실런트로 채워 **액이 닿는 면을 유리와 굳은 탄성체로만**
//    만든다. FDM 은 평면을 0.05 로 맞춰 주지 않지만, 실런트는 틈이 얼마든 채운다.
//    빔 여유도 편측 0.5 → 1.5 mm 로 넓어진다.
//  ★ 실런트는 **MS 폴리머(변성실란)**. 아세톡시 실리콘의 아세트산은 응력 있는 PMMA 를
//    크레이징시키고 베어 칩 패드를 부식시킨다. 중성경화 실리콘도 저분자 실록산이
//    광학면으로 이행해 발수화시킨다 — 20 µL 이 패치 8.6 mm 를 덮으려면 접촉각이
//    20° 급이어야 해서 치명적이다. 순간접착제·에폭시·UV경화는 전부 금지.
SEAL_W  = 0.8;    // 프리즘 옆 실런트 채널 폭(편측). FIT 0.35 를 위 SEAL_D 만 넓힌다
SEAL_D  = 2.0;    // 채널 깊이 (z = -SEAL_D ~ 0). 굳으면 z 윗면이 창의 y 벽이 된다
SEAL_REC = 0.4;   // 살 아랫면 실런트 링 깊이. 프리즘 상면까지 실제 두께는 +P_SEAT
SEAL_RX = 12;     // 실런트 링 바깥 x — 창(7)에서 5 mm
SEAM_SX = 1.0;    // 분할면 주입 슬롯 폭 (x)
SEAM_W  = 1.2;    // 분할면 주입 슬롯 폭 (y). 블록 윗면에 열려 주입구를 겸한다
SEAM_X  = 10.5;   // 주입 슬롯 중심 x — 창이 z=3.5 에서 8.63 까지 벌어지므로 그 밖
WIN_HX  = 7;      // 창 반폭 x — 패치 8.6 + 액적 여유
WIN_HY  = P_THICK/2 + SEAL_W;   // 5.8 ★ 실런트 채널 바깥벽과 **같은 값**. 따로 안 정한다
WIN_TAP = 25;     // 창 사면 각 (수직에서)
CAP_TAP = 12;     // 뚜껑 보스 사면 — 창보다 완만해서 아래 모서리가 선접촉
SEAT    = 0.8;    // 뚜껑이 사면에 걸려 뜨는 높이
HUB_Z   = 49;      // ★ 프리즘이 아니라 팔 끝이 정한다
WALL    = 3.5;  M3 = 3.4;
WALL_TOP = 3.2;   // ★ 창이 가장 넓어지는 **블록 윗면**의 살. HUB_Y 가 여기서 나온다

// ── 배선 슬롯 (2026-09-04 — 슈라우드를 버려 여기가 외광의 유일한 통로가 됐다) ──
SLOT_W   = 4;     // 슬롯 폭 (y)
SLOT_H   = 6;     // 슬롯 높이 (z)
SLOT_OFF = 4.5;   // ★ y 로 비키는 양. SLOT_W 보다 커야 직선 경로가 끊긴다
SLOT_MOUTH = 4;   // 포켓/캐비티와 이어 주는 입 길이 (x)

// ── 받침대 ─────────────────────────────────────
BASE_W = 220; BASE_D = 70; BASE_T = 6;
BASE_Z = -49;     // 바닥판 윗면 = 블록 바닥 (뜨지 않는다)
RAIL_LEN = 90; RAIL_T = 5; RAIL_H = 19;   // ★ 관통 M3 구멍 위로 살 4.3 mm. 15 면 0.30 mm 였다

// ============================================================================
//  유도값
// ============================================================================
//  ★ 옛 식 HUB_Y = P_THICK + 2*FIT + 2*WALL = 17.7 은 **포켓만** 보고 정한 값이었다.
//    창이 25° 로 벌어지므로 블록 윗면에서 창 반폭이 WIN_HY + HUB_TOP*tan25 = 7.20 이
//    되어 살이 1.65 mm 밖에 안 남는다. "따로 정한 두 치수를 대조하지 않은" 사례가
//    또 하나다. 이제 **둘 중 큰 쪽**으로 유도하고 아래 assert 가 지킨다.
//    ★ thincheck 는 Y=0 단면만 본다 — **두께 방향 살은 거기 안 걸린다.** 그래서
//      이 항목은 검사가 아니라 assert 로 지켜야 한다.
HUB_Y  = 2*max(P_THICK/2 + FIT + WALL,                       // 포켓 기준   8.85
               WIN_HY + HUB_TOP*tan(WIN_TAP) + WALL_TOP);    // 창 윗면 기준 10.40
XP     = sqrt(pow(P_R + FIT, 2) - pow(P_CZ + FIT - P_SEAT, 2)); // 30.35 포켓 입구 반폭
//  ★ 빔의 두께 방향 폭은 **젖은 유리 안**에 들어와야 한다. 젖는 유리는 이제 프리즘
//    전폭 10 mm 이므로 CH_Y = 7 이면 편측 1.5 mm 여유다 (옛 창 8 에서는 0.5 였다).
//    넓히면 광량은 늘지만 잡음 항이 이미 0.0026 PSU 라 얻을 것이 없다.
//    ★ CH_Y 와 P_THICK 은 서로 모르는 채 손으로 정한 두 값이다 — assert 로 묶는다.
CH_Y   = 7;                                      //       채널 폭(두께 방향)

assert(CH_Y/2 + 1.0 <= P_THICK/2,
       "빔이 젖은 유리 밖으로 나간다 — CH_Y 를 줄이거나 두꺼운 프리즘을 쓸 것");
assert(HUB_Y/2 - (WIN_HY + HUB_TOP*tan(WIN_TAP)) >= 3.0,
       "블록 윗면 창 둘레 살이 3 mm 미만이다");
//  ★ 주입 슬롯이 창과 뚫리면 실런트가 광학면으로 쏟아진다. 창은 위로 갈수록 넓다.
assert(SEAM_X - SEAM_SX/2 > WIN_HX + (HUB_TOP + 0.5)*tan(WIN_TAP) + 1.0,
       "분할면 주입 슬롯이 측정창에 너무 가깝다 — 실런트가 광학면으로 샌다");
assert(SEAM_X + SEAM_SX/2 < SEAL_RX, "주입 슬롯이 실런트 링 밖이라 채워지지 않는다");
assert(SEAL_RX < XP - 2, "실런트 링이 프리즘 밖으로 나갔다 — 실링이 안 된다");
//  ★ 액적이 실런트 링보다 깊으면 인쇄물 벽에 닿고 분할면 크랙에 물린다.
assert(20/(2*WIN_HX*2*WIN_HY) < SEAL_REC,
       "20 µL 액적이 실런트 링보다 깊다 — 인쇄물 벽에 닿는다");
assert(SLOT_OFF - SLOT_W/2 > SLOT_W/2,
       "배선 슬롯이 안 꺾였다 — 끝면에서 칩이 직선으로 보인다");
assert(HUB_Y/2 - (SLOT_OFF + SLOT_W/2) >= 3.0, "배선 슬롯 바깥 살이 3 mm 미만이다");
BAF_T  = 1.2;                                    //       인쇄 조리개 두께
BAF_AY = CH_Y - 1;                               // 6     조리개 개구 폭
SEAM   = 1.0;                                    //       분할면 랩 조인트 단차
PEG_D  = 4;
M4     = 4.4;

// 칩 자리 (설계 좌표) — 배선 슬롯을 여기서 옆으로 뺀다
CHIP_X = EXIT_X + ARM_D*cos(ARM_DEG);
CHIP_Z = EXIT_Z - ARM_D*sin(ARM_DEG);

// 조명측 플러그 캐비티의 바깥 끝 (설계 좌표) — 배선 슬롯을 여기서 옆으로 뺀다
PLUG_X = -(EXIT_X + (REACH_I + 2)*cos(ARM_DEG));
PLUG_Z = EXIT_Z - (REACH_I + 2)*sin(ARM_DEG);

// 조립 볼트 — 포켓도 광로도 피한 네 자리 (head.html g0.bolts 와 같은 식)
// 0.74 였을 때 오른쪽 볼트가 **배선 슬롯을 관통**했다 (단면 확인, 2026-09-02).
// 0.60 으로 올리면 검출측 슬롯 위 5.6 mm · 조명측 캐비티 위 3.4 mm 가 남는다.
BOLTS = [[-(HUB_L-6), -HUB_Z*0.60], [HUB_R-6, -HUB_Z*0.60],
         [-HUB_L*0.32, -(P_SAG+6)], [HUB_R*0.32, -(P_SAG+6)]];
// 아래 두 개는 홈턱까지 관통해 **본체를 받침대에 붙드는 볼트**를 겸한다 (M3 x 35)
RAIL_BOLTS = [BOLTS[2], BOLTS[3]];
XC = (HUB_R - HUB_L)/2;   // 블록 중심 x = 5

// ============================================================================
//  기본 형상
// ============================================================================

// 팔 축 위에서 작업.  s = +1 검출(오른쪽) / -1 조명(왼쪽),  L = E 에서의 거리
//   자식 좌표계 : +Z = 팔 진행 방향,  +X = 면내 수직,  +Y = 두께 방향
module on_arm(s, L) {
    translate([s*(EXIT_X + L*cos(ARM_DEG)), 0, EXIT_Z - L*sin(ARM_DEG)])
        rotate([0, s*(90 + ARM_DEG), 0])
            children();
}

// 프리즘 본체 (f = 편측 여유, dz = 원통만 올리는 양).  P_CZ 는 곡률 중심.
//   ★ 포켓은 prism(FIT, FIT - P_SEAT) 로 만든다 — 원통만 올라가고 상면(z=0)은
//     그대로다. 그래야 실물이 앉는 높이가 정해진다. dz=0 이면 실물 그 자체다.
module prism(f = 0, dz = 0) {
    intersection() {
        translate([0, 0, P_CZ + dz]) rotate([-90, 0, 0])
            cylinder(h = P_THICK + 2*f, r = P_R + f, center = true);
        translate([0, 0, -(P_SAG + f)/2 - 0.5])
            cube([P_CHORD + 2*f + 2, P_THICK + 2*f + 0.02, P_SAG + f + 1], center = true);
    }
}

// 앉은 자세의 실물 프리즘 — 그림용. 상면이 z = -P_SEAT 다.
module prism_seated() { translate([0, 0, -P_SEAT]) prism(0); }

// 블록 외형 단면 (XZ).  프리즘 포켓과 측정창은 두께 방향으로 제한해야 하므로
//   여기서 빼지 않고 따로 절삭한다.
//   ★ 2026-09-04 정정 — 여기 "창 밖에 남는 살이 프리즘을 위에서 물어 준다" 고
//     적혀 있었는데 **사실이 아니었다** (P_SEAT 주석). 프리즘은 포켓 바닥에 앉고
//     실런트가 붙든다. 살은 P_SEAT 만큼 떠 있고, 그 틈은 실런트 링이 채운다.
module body_profile() {
    polygon([[-HUB_L, -HUB_Z], [HUB_R, -HUB_Z], [HUB_R, HUB_TOP], [-HUB_L, HUB_TOP]]);
}

// 사면 상자 — z=0 에서 반폭 (hx,hy), 각도 tap 로 위로 벌어진다. z0~z1 구간만.
module taper_box(hx, hy, z0, z1, tap) {
    hull() {
        translate([0, 0, z0])
            cube([2*(hx + z0*tan(tap)), 2*(hy + z0*tan(tap)), 0.001], center = true);
        translate([0, 0, z1])
            cube([2*(hx + z1*tan(tap)), 2*(hy + z1*tan(tap)), 0.001], center = true);
    }
}

module body_solid() {
    rotate([90, 0, 0]) linear_extrude(height = HUB_Y, center = true) body_profile();
}

// 광로 채널 : from ~ to (팔 축 L).  Y 는 프리즘 두께보다 좁게 유지해 측벽을 살린다
module channel(s, from, to) {
    on_arm(s, (from + to)/2)
        cube([WIN_Z, CH_Y, to - from], center = true);
}

// 인쇄 조리개 — 채널을 뚫은 뒤 **다시 채워 넣는** 얇은 판.
//   개구가 국소 빔 폭에 맞춰 커진다. 따로 끼울 부품이 없고 비용도 0.
module baffle(s, L, ap) {
    on_arm(s, L) difference() {
        cube([WIN_Z, CH_Y, BAF_T], center = true);
        cube([ap, BAF_AY, BAF_T + 1], center = true);
    }
}

module baffles() {
    for (t = STOPS_D) baffle( 1, t[0], t[1]);
    for (t = STOPS_I) baffle(-1, t[0], t[1]);
}

// ============================================================================
//  본체 (두 반쪽을 합친 온전한 형상)
// ============================================================================
// 배선 슬롯 — **y 로 꺾어서** 끝면으로 뺀다 (2026-09-04).
//   슈라우드를 버렸으므로 이 구멍 두 개가 블록 안으로 들어오는 **외광의 유일한
//   통로**다. 곧게 뚫으면 오른쪽 끝면에서 칩 수광창이, 왼쪽 끝면에서 LED 캐비티가
//   그대로 보인다. 입(SLOT_MOUTH)에서만 y 로 열고 몸통은 SLOT_OFF 만큼 비켜 놓으면
//   직선 경로가 끊긴다. 남는 것은 두 번 꺾인 산란광뿐이고 그건 다크프레임이 뺀다.
//   ★ 마감은 **배선 후 검정 실런트로 끝면을 메우는 것**이다.
module wire_slot(x_in, x_out, z) {
    s = sign(x_out - x_in);
    // 입 — 포켓/캐비티에서 옆으로 비켜 나가는 짧은 구간. y 로 열려 있다.
    translate([x_in + s*SLOT_MOUTH/2, SLOT_OFF/2, z])
        cube([SLOT_MOUTH, SLOT_OFF + SLOT_W, SLOT_H], center = true);
    // 몸통 — y 로 비킨 채 끝면까지
    translate([(x_in + s*SLOT_MOUTH + x_out)/2, SLOT_OFF, z])
        cube([abs(x_out - x_in) - SLOT_MOUTH, SLOT_W, SLOT_H], center = true);
}

module body_full() {
    union() {
        difference() {
            body_solid();

            // 프리즘 포켓 — 두께 방향으로 제한된다 (측벽이 남아야 한다).
            //   ★ 원통을 FIT-P_SEAT 만큼 올려 **앉는 높이를 정한다**. 전에는 안 올려
            //     프리즘이 0.35 내려앉았다 (P_SEAT 주석 참조).
            prism(FIT, FIT - P_SEAT);

            // ── 실런트 채널 (2026-09-04 신설) ──────────────────────────────
            //  프리즘 옆면과 포켓 벽 사이 FIT 0.35 는 액이 **곡면(광 입출사면)까지
            //  가는 유일한 길**이다. 곡면이 젖으면 닦을 수도 마를 수도 없다.
            //  위 SEAL_D 만 SEAL_W 로 넓혀 주사기가 들어가게 하고, 여기 채워 굳은
            //  탄성체가 **창의 y 벽**이 된다. 창을 프리즘보다 넓게 여는 근거다.
            for (sd = [-1, 1])
                translate([0, sd*(P_THICK/2 + (FIT + SEAL_W)/2), -SEAL_D/2])
                    cube([2*XP, SEAL_W - FIT, SEAL_D], center = true);

            // 측정창 — 사면. 프리즘 **두께 전폭**으로 연다 (2026-09-04 개정).
            taper_box(WIN_HX, WIN_HY, -0.5, HUB_TOP + 0.5, WIN_TAP);

            // ── 실런트 링 자리 (2026-09-04 신설) ───────────────────────────
            //  살 아랫면을 창 둘레로 SEAL_REC 만큼 파낸다. 프리즘 상면(z=-P_SEAT)과
            //  이 면 사이 0.55 mm 가 통째로 실런트로 찬다.
            //  ★ 이렇게 하면 **액이 닿는 것은 유리와 굳은 탄성체뿐이고 인쇄물이
            //    아니다.** 액적 깊이는 20 µL / (14 x 11.6) = 0.12 mm 라 SEAL_REC
            //    안에 들어온다. 인쇄 공차로 살이 프리즘에 닿든 말든 결과가 같다 —
            //    "면끼리 딱 맞물리게 한다"는 FDM 에서 지킬 수 없는 약속이다.
            translate([0, 0, SEAL_REC/2])
                cube([2*SEAL_RX, 2*WIN_HY, SEAL_REC], center = true);

            // ── 분할면 실런트 주입 슬롯 (2026-09-04 신설) ──────────────────
            //  ★ 분할면 Y=0 이 젖은 창을 가로지른다. 그 크랙이 창에서 프리즘 끝까지
            //    이어져 액을 다 빨아먹고 포켓으로 간다 — 캡보다 이게 큰 문제였다.
            //    블록 윗면에 열린 이 슬롯으로 실런트를 넣으면 (1) 크랙을 끊고
            //    (2) 아래 실런트 링과 옆 채널까지 흘러 한 번에 채워진다.
            //  ★ 창에서 SEAM_X 만큼 떨어뜨린 이유 : 창 사면이 위로 갈수록 벌어져
            //    z=3.5 에서 반폭이 8.63 이다. 가까이 두면 슬롯이 창과 뚫려 실런트가
            //    광학면으로 쏟아진다. (첫 배치 8.4 가 정확히 그랬다.)
            for (sx = [-1, 1])
                translate([sx*SEAM_X, 0, (HUB_TOP + 0.6)/2 - 0.1])
                    cube([SEAM_SX, SEAM_W, HUB_TOP + 0.6], center = true);

            // 광로 : 곡면 안쪽 2 mm 에서 팔 끝까지
            channel( 1, -2, ARM_D);
            channel(-1, -2, ARM_I);

            // 조명측 플러그 소켓 — 슬릿판/렌즈판을 갈아끼우는 자리
            on_arm(-1, (ARM_I + REACH_I + 2)/2)
                cube([PLUG_W, PLUG_Y, REACH_I + 2 - ARM_I], center = true);

            // 칩 포켓 — 어레이 8.064 의 길이 방향이 부채꼴 방향(면내)에 오게 눕힌다
            on_arm(1, ARM_D + (CHIP_H + 0.3)/2)
                cube([CHIP_L + 0.4, CHIP_W + 0.4, CHIP_H + 0.3], center = true);

            // 배선 슬롯 — 칩 뒤에서 오른쪽 끝면으로. 축으로 빼면 블록이 3 mm 깊어지고
            //   바닥으로 빼면 받침대에 눌린다.
            wire_slot(CHIP_X, HUB_R + 1, CHIP_Z);

            // LED 배선 슬롯 — 플러그 캐비티 끝에서 왼쪽 끝면으로. 캐비티를 축 방향으로
            //   끝면까지 뚫으면 블록이 5 mm 더 깊어진다. 플러그는 분할면에서 넣는다.
            wire_slot(PLUG_X, -HUB_L - 1, PLUG_Z);

            // 조립 M3
            for (p = BOLTS)
                translate([p[0], 0, p[1]]) rotate([90, 0, 0])
                    cylinder(h = HUB_Y + 4, d = M3, center = true);
        }
        baffles();
        hinge_ears();
    }
}

// ── 분할 ─────────────────────────────────────────────────────────────────
//  ★ 분할면은 광로 한가운데를 196 mm 내내 지나간다. 평평한 면끼리 맞대면
//    그 이음매가 검출기까지 직통하는 **빛 새는 틈**이 된다.
//    그래서 채널 둘레에서만 분할면을 한 단(SEAM) 옮겨 랩 조인트를 만든다.
module seam_claim(clr = 0) {
    for (s = [-1, 1])
        let (reach = (s > 0) ? REACH_D : REACH_I)
            on_arm(s, (reach - 2)/2)
                translate([0, -SEAM/2, 0])
                    cube([WIN_Z + 8 + 2*clr, SEAM + 2*clr, reach + 2 + 2*clr], center = true);
}

// B(Y>0) 가 가져가는 영역
module claim_b(clr = 0) {
    union() {
        translate([0, 200, 0]) cube([600, 400, 400], center = true);
        seam_claim(clr);
    }
}

PEGS = [[-60, -44], [70, -44]];

module hub_half(side) {
    difference() {
        if (side > 0) intersection() { body_full(); claim_b(0); }
        else          difference()   { body_full(); claim_b(0.2); }

        // A 쪽에 페그 구멍
        if (side < 0)
            for (p = PEGS) translate([p[0], -PEG_D/2, p[1]])
                rotate([90, 0, 0]) cylinder(h = PEG_D + 0.4, d = PEG_D + 0.3, center = true);
    }
    // B 쪽에 페그 — 분할면에서 A 쪽(Y<0)으로 튀어나간다
    if (side > 0)
        for (p = PEGS) translate([p[0], -PEG_D/2 + 0.01, p[1]])
            rotate([90, 0, 0]) cylinder(h = PEG_D, d = PEG_D, center = true);
}

// ============================================================================
//  받침대 — 바닥판 + 홈턱 + 힌지 기둥 + M4 수평조절 3점
//    ★ 블록 바닥이 바닥판 윗면에 **닿는다**. 옛 배치는 1 mm 떠 있어서 수직
//      기준면이 없었다 — 홈턱 옆면만으로는 뚜껑 닫는 힘에 흔들린다.
//    ★ 홈턱은 블록의 **두께 방향**으로 벌어진다. 가운데 M3 두 개가 홈턱-블록-홈턱을
//      관통해 본체를 붙든다 (M3 x 35). 새 나사가 늘지 않는다.
// ============================================================================
FEET = [[-88.2, BASE_D*0.34], [XC, -BASE_D*0.34], [96.6, BASE_D*0.34]];

module base() {
    difference() {
        union() {
            // 바닥판 — 충진을 아끼지 말 것. 무게가 곧 안정성이다.
            translate([XC, 0, BASE_Z - BASE_T/2])
                cube([BASE_W, BASE_D, BASE_T], center = true);
            // 홈턱 2줄
            for (sd = [-1, 1])
                translate([XC, sd*(HUB_Y/2 + RAIL_T/2 + 0.3), BASE_Z + RAIL_H/2])
                    cube([RAIL_LEN, RAIL_T, RAIL_H], center = true);
        }
        // 홈턱 관통 M3 (본체 고정 겸용)
        for (p = RAIL_BOLTS)
            translate([p[0], 0, p[1]]) rotate([90, 0, 0])
                cylinder(h = BASE_D + 4, d = M3, center = true);
        // M4 수평조절 3점 — 삼각 지지라 덜컹거리지 않는다
        for (f = FEET)
            translate([f[0], f[1], BASE_Z - BASE_T/2])
                cylinder(h = BASE_T + 2, d = M4, center = true);
    }
}

// ============================================================================
//  뚜껑과 힌지 — **작은 판 + 허브에 뚫은 피벗 구멍** (2026-09-04)
//
//  전(2026-09-02)에는 상부 전체를 덮는 슈라우드 204 x 42 x 57 이었다. 버린 이유 :
//    · 차광의 본체는 사실 **창을 막는 보스**다. 슈라우드는 그 위에 덧씌운 것이었다.
//    · 나머지 외광 경로는 **배선 슬롯 두 곳**뿐인데, 그건 슬롯을 y 로 꺾어(도그레그)
//      끝면에서 칩·캐비티가 직선으로 안 보이게 하는 편이 훨씬 싸다. body_full 참조.
//    · 슈라우드는 벗겨서 어딘가에 놓아야 하는데 놓을 자리가 없다. 뚜껑은 달려 있다.
//
//  ★ 하중 — 슈라우드는 벽이 바닥판에 내려앉아 본체를 안 건드렸다. 이 뚜껑은 허브에
//    직접 달리므로 하중이 본체로 간다. 그래서 셋을 지킨다 :
//      (1) **래치·자석·스냅을 달지 않는다.** 닫는 힘은 자중뿐(약 0.2 N)이다.
//          손으로 누르면 검출팔 60 mm 끝의 칩이 미끄러진다 (1 µm = 0.061 PSU).
//      (2) 피벗 구멍을 **헐겁게** 판다 (LID_PIV 3.8 에 M3). 보스가 창 사면에서
//          스스로 중심을 잡아야 하는데 힌지가 뻑뻑하면 그걸 방해하고 옆으로 민다.
//          ★ 피벗 나사를 조이지 말 것. 조이면 자기정렬이 죽는다.
//      (3) 판을 왼쪽으로 길게 뺀다 — 무게중심이 보스보다 멀어 지렛대로 눌러 준다.
//          (무게중심 x≈-14, 피벗에서 54 : 보스는 40 이므로 자중의 약 1.35 배)
//
//  ★ 자중이 슈라우드(약 0.7 N)보다 작으므로 **증기 웰의 밀폐가 사면 인쇄 품질에
//    더 의존한다.** 1순위 검증에 "뚜껑 닫고 10 분 방치 후 재측정"을 넣을 것.
//    새면 대안은 보스 사면에 실런트로 성형하는 탄성 립이다 (부품이 늘지 않는다).
//
//  ★ 인쇄 : **보스가 위로 오게 뒤집어서** 놓는다. 그러면 판 윗면이 바닥에 붙고
//    보스도 팔도 서포트가 필요 없다. 보스와 판 밑면은 무광 검정으로.
// ============================================================================
HINGE_X  = 40;                 // 프리즘 끝(XP=30.35) 밖. 광로는 |x|>25 에서 아래로 간다
LID_GAP  = 0.5;                // 판 밑면과 블록 윗면 사이 — 판이 본체를 누르지 않는다
LID_T    = 5;                  // 판 두께
HINGE_Z  = HUB_TOP + LID_GAP + LID_T/2;   // 6.0  판 두께의 한가운데
EAR_T    = 4;                  // 귀 두께 — 각 반쪽의 바깥면에서 안쪽으로
EAR_R    = 4;                  // 귀 꼭대기 반지름 — 구멍(2.8) 위로 살 2.6
EAR_TAP  = 2.8;                // M3 셀프태핑
LID_X0   = -72;                // 판 왼쪽 끝
LID_X1   = HINGE_X - EAR_R - 0.5;         // 35.5  판 오른쪽 끝 — 귀 앞에서 멈춘다
LID_ARM  = 3;                  // 팔 두께
LID_CLR  = 0.4;                // 팔과 귀 사이 편측 여유
LID_PIV  = 3.8;                // ★ 팔의 피벗 구멍. M3 에 0.4 유격 — 자기정렬용
LID_HY   = HUB_Y/2 + LID_CLR + LID_ARM;   // 판 반폭

// 허브에 붙는 귀 — 바깥면 쪽 EAR_T 만큼만 차지하므로 A/B 가 각자 하나씩 가져간다.
//   허브 안으로 4 mm 파묻혀 있어 뿌리가 끊어지지 않는다.
module hinge_ears() {
    for (sd = [-1, 1])
        translate([0, sd*(HUB_Y/2 - EAR_T/2), 0])
            rotate([90, 0, 0])
                linear_extrude(height = EAR_T, center = true)
                    difference() {
                        hull() {
                            translate([HINGE_X, HINGE_Z]) circle(r = EAR_R);
                            translate([HINGE_X - EAR_R, HUB_TOP - 5]) square([2*EAR_R, 1]);
                        }
                        translate([HINGE_X, HINGE_Z]) circle(d = EAR_TAP);
                    }
}

// 닫힌 자세의 뚜껑
module lid_closed() {
    union() {
        // 판
        translate([(LID_X0 + LID_X1)/2, 0, HUB_TOP + LID_GAP + LID_T/2])
            cube([LID_X1 - LID_X0, 2*LID_HY, LID_T], center = true);

        // 증기 웰 보스 — 창 사면에 **아래 모서리로 선접촉**해 자기정렬하고 SEAT 만큼
        //   뜬다. 보스 사면(CAP_TAP 12°)이 창(WIN_TAP 25°)보다 완만해서 위로 갈수록
        //   벌어진다 — 접촉선은 딱 z=SEAT 한 줄이고 그 위는 안 닿는다.
        taper_box(WIN_HX + SEAT*(tan(WIN_TAP) - tan(CAP_TAP)),
                  WIN_HY + SEAT*(tan(WIN_TAP) - tan(CAP_TAP)),
                  SEAT, HUB_TOP + LID_GAP + LID_T, CAP_TAP);

        // 팔 둘 — 귀 **바깥**으로 지나가 피벗까지. 판과 hull 로 이어 붙인다.
        for (sd = [-1, 1])
            translate([0, sd*(HUB_Y/2 + LID_CLR + LID_ARM/2), 0])
                rotate([90, 0, 0])
                    linear_extrude(height = LID_ARM, center = true)
                        difference() {
                            hull() {
                                translate([HINGE_X, HINGE_Z]) circle(r = EAR_R + 1);
                                translate([LID_X1 - 6, HUB_TOP + LID_GAP]) square([6, LID_T]);
                            }
                            translate([HINGE_X, HINGE_Z]) circle(d = LID_PIV);
                        }
    }
}

// open = 여는 각도(도). 0 이 닫힌 자세. swingcheck 가 이걸 훑는다.
module lid(open = 0) {
    translate([HINGE_X, 0, HINGE_Z])
        rotate([0, open, 0])
            translate([-HINGE_X, 0, -HINGE_Z])
                lid_closed();
}

// ============================================================================
//  조명측 플러그 + 슬릿판 — **슬릿은 따로 뽑아 끼우는 카드**다 (2026-09-04)
//
//    빛의 길 (z 는 프리즘 쪽 0 → LED 쪽 22.6) :
//      LED → 공동 → 유산지(확산판) → 방 → **슬릿판의 틈** → 프리즘
//
//  ★★ 슬릿을 커터칼 날에서 **인쇄한 틈**으로 바꿨다. 옛 설계는 날 두 장을 마주
//    보게 끼우고 종이 심으로 폭을 맞추는 것이었는데 셋이 한꺼번에 걸렸다 :
//      (1) 실물 날이 안 들어간다. 슬롯이 받는 것은 한 장당 4.76 x 7 인데 9 mm 날은
//          등까지 폭이 9 다. 게다가 스냅오프 날은 **45°로 쪼개져 평행사변형**이라
//          감싸는 사각형이 15.2 x 9 (한 마디) / 21.3 x 9 (두 마디)다.
//          담으려면 블록이 25~31 mm 가 된다 (지금 20.8). 그리고 **금속 날은 네모나게
//          가공할 수 없다** — 생긴 그대로 담아야 한다.
//      (2) 한 마디의 날끝이 6.15 mm 뿐이라 빔 폭 CH_Y=7 을 **못 덮는다.**
//      (3) 심을 빼면 **날을 붙들어 두는 것이 없다.** 슬릿이 옆으로 1.26 µm 움직이면
//          예산 전체(0.066 PSU)를 먹는다 — 슬릿~M 이 70, 지렛대가 90 이라
//          슬릿 1 µm 가 칩에서 1.29 µm = 0.052 PSU 다.
//    인쇄한 판은 (3)을 **원천적으로** 없앤다 — 한 몸이라 움직일 방법이 없다.
//
//  ★ 왜 인쇄로 되는가 — 직선도가 덜 중요하다. `src/profile_crb.py` 의 결론이
//    **"번짐을 100배 늘려도 σ 는 2.5배만 나빠진다"** 이다. 가장자리의 물결(압출 폭
//    변동, ±0.05 급)은 번짐으로만 나타나고, 가장자리의 **평균 위치**는 8 mm 를 따라
//    평균되어 오히려 안정적이다. 남는 편심은 고정값이라 2점 보정이 상수로 흡수한다
//    (부채꼴 여유 ±0.30° = 편심 ±0.37 mm 까지 무해).
//
//  ★ 왜 따로 뽑는가 — **한 몸이면 다듬을 수 없다.** 카드로 빼 놓으면
//    (가) 불빛에 비춰 슬릿을 눈으로 검사하고, (나) 강철자를 대고 칼로 다듬고,
//    (다) **폭이 다른 판을 여러 장 뽑아 갈아 끼운다** — 1순위 §6 의 슬릿 폭 스윕이
//    바로 이것이다. 본체도 플러그도 다시 안 뽑는다.
//
//  ★ 왜 바닥면인가 — 옆벽은 레이어 줄무늬가 남지만 **바닥면은 베드가 찍어 주므로
//    평평하다.** 판을 **눕혀서** 인쇄하면 슬릿을 정의하는 면이 바닥면이 된다.
//
//  ★★ 슬릿 폭 — **왜 0.30 인가** (2026-09-04)
//    옛 문서의 "권장 0.19" 는 √(λ · **기계** 검출팔 60) 이었다. 2026-09-02 의
//    "기계팔 ≠ 광학 지렛대" 정정이 **이 줄에는 안 닿았다.** 광학 지렛대로 다시
//    잡으면 (a = R+조명팔 = 70 슬릿→M, b = R+검출팔 = 90 M→칩) :
//        기하 번짐 = 슬릿 x b/a ,  회절 번짐 ~ λ(a+b)/슬릿
//        **번짐이 최소가 되는 폭 = sqrt(λ(a+b)·a/b) = 0.27 mm**
//
//    ★ 그런데 **번짐 최소 = σ 최소가 아니다.** 슬릿을 넓히면 번짐과 함께 **광량도**
//      늘기 때문이다. CRB 는 σ ∝ σ_n·√(번짐)/진폭 인데 기하 영역에서 진폭 ∝ 슬릿,
//      번짐 ∝ 슬릿이므로 σ ∝ σ_n/√슬릿 — **넓힐수록 좋아진다.**
//        슬릿   번짐(px)   σ(읽기잡음 지배)  σ(광자잡음 지배)   ← 0.27 을 1 로
//        0.20    8.5        1.41              1.21
//        0.27    7.8        1.00              1.00
//        0.30    7.8        0.90              0.95
//        0.45    9.7        0.67              0.87
//      즉 **0.45 도 "너무 크지" 않다.** 다만 이건 거친 모형이고, 정확한 판정은
//      `src/profile_crb.py` 와 **1순위 §6 슬릿 폭 스윕**이다. 스윕이 있는 이유다.
//
//    ★ 그래도 **좁은 쪽에서 시작한다.** 이유는 정밀도가 아니라 **공정**이다 —
//      **넓히는 것은 되지만 좁히는 것은 안 된다.** 그래서 기본값을 번짐 최소 근처인
//      0.30 으로 두고, 필요하면 칼로 넓힌다. (0.4 노즐이 0.30 을 못 갈라 주고 붙어
//      나오는 것이 보통인데, **그것이 의도한 경로다** — 붙어 나오면 갈라 쓴다.)
//
//    ★ 하한이 있다 : 슬릿이 판 두께에 비해 좁으면 **터널**이 되어 부채꼴 가장자리가
//      깎인다. 판 0.8 에서 **0.16 아래로는 깎지 말 것** (비네팅 20 %).
//
//
//  ★★ **슬릿 폭이 얼마나 일정해야 하나 — 거의 상관없다.** (2026-09-04)
//    0.27 ~ 0.38 로 들쑥날쑥해도 무해하다. 이유가 셋이다.
//      (1) **y 방향으로는 광학 파워가 없다.** 프리즘이 축이 y 인 반원통이라 y 로는
//          그냥 평판이고, 조리개 개구(BAF_AY=6)가 넓어 칩의 한 점이 슬릿 길이
//          **전체를 적분해서** 본다. 폭 변동은 해상되지 않고 **평균된다.**
//      (2) 평균된 유효 개구 = sqrt(평균² + 편차²). 0.27~0.38 이면 평균 0.325 에
//          편차 0.032 라 유효 0.327 — **+0.5 %.** 칩에서의 번짐이 8.01 → 8.03 px 다.
//      (3) 그 결과는 **고정 커널**이고, 프레넬 곡선은 염도에 따라 **강체 평행이동**
//          하므로 고정 커널과의 컨볼루션은 위치를 상수만큼 옮길 뿐이다.
//          **2점 보정이 그 상수를 흡수한다.**
//    · 폭이 한쪽으로 기울어 있어도 유효 중심은 최대 0.055 mm 밀린다 — 편심 예산
//      ±0.37 의 15 % 이고, 그마저 고정값이라 보정이 먹는다.
//    · ★ 오히려 **판이 홈 안에서 도는 쪽이 영향이 크다.** 여유 0.15 에 판 길이 9.5
//      이므로 최대 0.90°, 슬릿 길이 8 에서 유효 폭이 **+0.126 mm** 늘어난다
//      (0.30 → 0.326, +8.5 %). 그래도 무해하다.
//
//    ⚠ **정말 지켜야 하는 것은 균일함이 아니라 이 넷이다.**
//      · **움직이지 않을 것** — 1.26 µm 면 예산 전체다. 인쇄판이라 해결됐다
//      · **국소적으로 0.16 아래로 내려가지 않을 것** — 그 자리가 터널이 되어
//        부채꼴을 깎는다 (비네팅 0.10 → 31 %, 0.16 → 20 %, 0.27 → 12 %)
//      · **길이 8 mm 가 끊기지 않을 것**
//      · **불투명할 것** — 검정 필라멘트. 얇은 판은 비쳐 보일 수 있다
//    ★ 게이지는 **커터칼 날 자체**가 종이보다 낫다 — 강철이라 두께가 ±0.02 로
//      일정하고(종이는 ±10 %), **자를 때 쓴 그 날을 밀어 넣으면** 슬릿이 정확히 날
//      두께가 된다. 자기 게이지다. ★ **이 설계는 9 mm 날(0.38~0.45)로 확정**이다 —
//      18 mm(0.50)보다 최적에 가깝고, 최종 슬릿 폭이 곧 그 날 두께가 된다.
//      가진 날의 두께를 실측해 적어 둘 것.
//      억지로 밀지 말고 **미끄러지는지**로 판정한다.
//    ★ 어느 쪽이든 **실측해서 적어 두는 것**이 규약이다.
//      · SLIT_W = 0.30  기본값. 붙어 나오면 바닥면에 강철자를 대고 칼로 갈라낸다
//      · SLIT_W = 0     아예 막힌 카드로 뽑아 갈라낸다. 직선도는 강철자가 준다
//      · §6 스윕용으로 0.2 / 0.5 / 1 / 3 을 따로 뽑아 둔다
//
//  ★ 판은 플러그 안쪽 끝의 홈에 **y 로 떨어뜨려 넣는다.** 앞으로 빠지지 않는 이유는
//    블록 캐비티(10 x 10)와 광로 채널(5 x 7) 사이의 **턱**이 판을 막기 때문이다 —
//    잡아 주는 부품이 따로 없다. 홈이 x 로 막혀 있어 판의 좌우 위치가 정해진다.
//
//    인쇄 : 플러그는 **슬릿면을 바닥에** 놓고 세워서 (LED 구멍이 수직이 된다).
//           판은 눕혀서. 둘 다 서포트가 필요 없다. 무광 검정.
// ============================================================================
PLUG_CLR = 0.3;                       // 캐비티 대비 편측 여유
PLUG_LEN = REACH_I + 2 - ARM_I - 0.4; // 22.6

// ── 슬릿판 (따로 뽑는 카드) ─────────────────────────────────────────────
SLIT_W    = 0.30;  // 슬릿 폭 (면내). ★ 아래 "왜 0.30 인가" 참조. 0 이면 막힌 카드
SLIT_L    = CH_Y + 1;   // 8  슬릿 길이 (두께 방향). 빔보다 1 길어 판이 y 로 놀아도 덮는다
PLATE_T   = 0.8;   // 판 두께
PLATE_HX  = 3.35;  // 판 반폭 (면내). 플러그 살 1.4 를 남긴다
PLATE_CLR = 0.15;  // 홈 대비 여유
PLATE_LY  = PLUG_Y - PLUG_CLR - 0.2;  // 9.5  판 길이 (두께 방향)

// ── 플러그 내부 z 자리 — 순서대로 쌓는다. 손으로 두 번 정하지 않는다 ──────
PLATE_Z1 = PLATE_T + PLATE_CLR;          // 0.95  판 홈 윗면
CHAM_X   = 6;                            //       판 뒤 방 (면내). 판보다 좁아야 빛이 안 샌다
CHAM_Y   = 7;                            //       방 (두께 방향)
DIFF_Z0  = 3.05;                         //       확산판 슬롯 아랫면 (유산지가 앉는 턱)
DIFF_T   = 0.7;                          //       유산지 슬롯 두께
DIFF_Z1  = DIFF_Z0 + DIFF_T;             // 3.75
LED_Z    = 12.6;                         //       LED 압입 바닥
EPS      = 0.05;                         // CSG 겹침 — 잘라낸 상자끼리 면이 딱 맞물리면
                                         //   매니폴드가 부피 0 인 껍데기를 남긴다

assert(SLIT_L >= CH_Y + 1, "슬릿이 짧다 — 판이 y 로 놀면 빔이 잘린다");
assert(2*PLATE_HX > CHAM_X, "판이 방보다 좁다 — 빛이 판 옆으로 샌다");
assert(CHAM_Y >= CH_Y, "방이 빔보다 좁다");
assert((PLUG_W - PLUG_CLR)/2 - (PLATE_HX + PLATE_CLR/2) >= 1.2,
       "판 홈 옆 플러그 살이 1.2 미만이다");
//  ★ 슬릿이 판보다 훨씬 좁으면 **터널**이 되어 부채꼴 가장자리가 깎인다.
//    가장자리 비네팅 = PLATE_T·tan(부채꼴/2) / SLIT_W. 5배면 20 % 다.
//    (플랫필드가 고정 패턴은 나눠 없애므로 20 % 까지는 허용한다.)
//    판 0.8 에서 하한은 **0.16** — 다듬을 때 그 아래로 깎지 말 것.
assert(SLIT_W == 0 || SLIT_W/PLATE_T > 5*tan(4.5/2),
       "슬릿이 판 두께에 비해 좁다 — 터널이 되어 부채꼴이 깎인다");
assert(DIFF_Z0 > PLATE_Z1 + 1.0, "판과 확산판 사이 방이 없다");

// 갈아 끼우는 슬릿판 — 눕혀서 인쇄한다. 바닥면이 슬릿을 정의하는 면이다.
module slit_plate() {
    difference() {
        translate([0, 0, PLATE_T/2])
            cube([2*PLATE_HX, PLATE_LY, PLATE_T], center = true);
        if (SLIT_W > 0)
            translate([0, 0, PLATE_T/2])
                cube([SLIT_W, SLIT_L, PLATE_T + 2*EPS], center = true);
    }
}

module slit_plug() {
    difference() {
        translate([0, 0, PLUG_LEN/2])
            cube([PLUG_W - PLUG_CLR, PLUG_Y - PLUG_CLR, PLUG_LEN], center = true);

        // 슬릿판 홈 — x 로 막혀 판의 좌우 위치를 정하고, y 로 뚫려 떨어뜨려 넣는다
        translate([0, 0, PLATE_Z1/2])
            cube([2*PLATE_HX + PLATE_CLR, PLUG_Y + 2, PLATE_Z1 + 2*EPS], center = true);

        // 판 뒤 방 — 유산지에서 온 확산광이 슬릿을 넓은 각으로 채운다
        translate([0, 0, (PLATE_Z1 + DIFF_Z0)/2])
            cube([CHAM_X, CHAM_Y, DIFF_Z0 - PLATE_Z1 + 2*EPS], center = true);

        // 유산지 확산판 슬롯 — 옆에서 끼운다. DIFF_Z0 턱에 앉는다.
        translate([0, 0, (DIFF_Z0 + DIFF_Z1)/2])
            cube([PLUG_W + 2, PLUG_Y + 2, DIFF_T], center = true);

        // 확산판과 LED 사이 공동
        translate([0, 0, (DIFF_Z1 + LED_Z)/2])
            cube([CHAM_X + 1, CHAM_Y, LED_Z - DIFF_Z1 + 2*EPS], center = true);

        // LED 압입 (바깥 끝에서 넣는다) + 다리 관통
        translate([0, 0, PLUG_LEN + 0.1]) rotate([180, 0, 0]) cylinder(h = 10.2, d = LED_D);
        translate([0, 0, PLUG_LEN + 0.1]) rotate([180, 0, 0]) cylinder(h = 12,   d = 2.8);
    }
}

// 판을 끼운 플러그 — 조립도와 raycheck 가 쓴다
module slit_assy() {
    slit_plug();
    translate([0, 0, PLATE_CLR/2]) slit_plate();
}
// ============================================================================
//  조립 설명 — **반쪽 B 가 부품을 싣는 쪽**이다.
//    분할면의 랩 조인트(SEAM)가 채널 둘레에서 B 쪽으로 1 mm 넘어와 있으므로
//    B 의 홈이 더 깊다 : 플러그 6 mm (A 는 4) · 칩 2.7 mm (A 는 0.7).
//    그래서 B 를 분할면이 위로 오게 눕혀 놓고 **떨어뜨려 얹은 뒤** A 를 덮는다.
//    밀어 넣는 것이 아니다 — 어느 쪽으로도 뚫려 있지 않다.
// ============================================================================
CHIP_ARR = 8.064;   // 어레이 길이. 데이터시트 Figure 10

// TSL1401CL 이 놓이는 자세 — 어레이 길이 방향이 **부채꼴 방향(면내)**
module chip() {
    on_arm(1, ARM_D + CHIP_H/2 + 0.15) {
        color("#14181C") cube([CHIP_L, CHIP_W, CHIP_H], center = true);
        // 수광창 : 프리즘을 바라보는 면에 있다
        color("#6FC8F0") translate([0, 0, -CHIP_H/2 - 0.06])
            cube([CHIP_ARR, 0.8, 0.12], center = true);
    }
}

module loaded_b() {
    color("Silver", 0.55) hub_half(1);
    color("Tomato", 0.85) on_arm(-1, ARM_I) slit_assy();
    chip();
    color("SkyBlue", 0.35) prism_seated();
}

// ============================================================================
//  얇은 살 검사 — 단면에서 **THIN*2 보다 얇은 살**만 남겨 보여 준다.
//    열림(줄였다 늘리기)은 얇은 것을 지운다. 원본에서 그걸 빼면 얇은 데만 남는다.
//    이 프로젝트에서 같은 실수가 세 번 났다 (전부 이 검사에 걸렸을 것들이다) :
//      · 검출 채널이 블록 바닥을 0.07 mm 뚫음
//      · 힌지 기둥 꼭대기가 핀 구멍과 같은 높이 (구멍이 아니라 홈)
//      · 홈턱 관통 M3 구멍 위 살 0.30 mm
//
//    ⚠ **이 검사는 Y=0 단면만 본다.** 두께 방향(y)의 살은 여기 절대 안 걸린다.
//      2026-09-04 에 창 윗면 살이 1.65 mm 로 얇아진 것이 정확히 그 사각이었다 —
//      그건 검사가 아니라 유도값 옆의 **assert** 가 지킨다. 새 y 방향 치수를
//      넣을 때는 이 검사를 믿지 말고 assert 를 하나 더 쓸 것.
//
//    ⚠ **볼록한 모서리는 원래 걸린다** (열림이 모서리를 둥글리기 때문). 개수가 아니라
//      **면적**으로 판단할 것. 2026-09-04 실측값이고 전부 의도한 것이다 :
//        · 62 mm² 편측  x  7 ~ 30.4, z 0~3  — 측정창 턱(프리즘 위 살). 두께가
//          HUB_TOP = 3 이라 문턱 3 과 같아 **통째로** 걸린다. 실런트 링(SEAL_REC)
//          자리에서는 2.6 mm 로 더 얇다 — 아래가 굳은 탄성체로 받쳐지므로 의도한 것.
//        · 6.05 / 3.52 / 3.19 mm²  x -64.5~-56.8 / -50.7~-47.5 / -40.7~-37.4
//                                   — 조명측 인쇄 조리개 세 자리의 어깨
//        · 1.88 mm²  x 72.5~75      — 검출측 조리개 어깨
//        · 2.64 / 2.62 mm²  x -93~-85 / -85~-81.5 — 플러그 캐비티·LED 슬롯의 쐐기
//        · 2.41 mm²  x 75~84.3      — 칩 포켓과 배선 슬롯 입이 만나는 쐐기
//        · 1.66 mm²  x 101.5~103    — 오른쪽 끝면 모서리
//        · 0.83 mm²  x 48.5~50      — **받침대** 홈턱 끝 모서리 (본체가 아니다)
//      총 155.7 mm² (옛 배치 164.9 에서 줄었다). **이 목록에 없는 것이 나오면 버그다.**
// ============================================================================
THIN = 1.5;   // 반경. 2*THIN = 3 mm 미만이 잡힌다

module thin_of() {
    difference() {
        children();
        offset(r = THIN) offset(r = -THIN) children();
    }
}

module thincheck() {
    // 본체 — 분할면 단면
    thin_of() projection(cut = true) rotate([-90, 0, 0]) body_full();
    // 받침대 — 홈턱을 지나는 단면
    thin_of() projection(cut = true) rotate([-90, 0, 0])
        translate([0, HUB_Y/2 + RAIL_T/2 + 0.3, 0]) base();
}

// ============================================================================
module preview() {
    color("Silver",  0.35) body_full();
    color("SkyBlue", 0.55) prism_seated();
    color("Gray",    0.60) base();
    color("Tan",     0.45) lid();
    color("Tomato",  0.70) on_arm(-1, ARM_I) slit_assy();
}

if      (PART == "hub_a")     hub_half(-1);
else if (PART == "hub_b")     hub_half(1);
else if (PART == "base")      base();
else if (PART == "lid")       lid();
else if (PART == "slit_plug") slit_plug();
else if (PART == "slit_plate") slit_plate();
// 검증용 : 분할면(Y=0) 단면. docs/head.html "도면 2" 와 대조한다.
//   openscad --backend=manifold -o section.dxf -D "PART=\"section\"" optical_bench.scad
else if (PART == "section")   projection(cut = true) rotate([-90, 0, 0]) body_full();
else if (PART == "load")      loaded_b();
// 검증용 : **닫힌 자세**에서 뚜껑이 본체·받침대를 파고드는지. 비어 있어야 한다.
//   openscad -o fit.stl -D "PART=\"fitcheck\"" optical_bench.scad
//   -> "Current top level object is empty" 가 나오면 간섭 없음.
//   ★ 보스와 창은 z=SEAT 에서 **선으로** 닿는다. 선접촉은 부피가 0 이라 안 걸린다.
else if (PART == "fitcheck")  intersection() { lid(); union() { base(); body_full(); } }
// 검증용 : 뚜껑을 **여는 동안** 본체와 부딪히는지. 10°~90° 를 겹쳐 본다. 비어야 정상.
//   힌지를 허브에 달면서 새로 생긴 검사다 — 슈라우드에는 없던 실패 모드다.
else if (PART == "swingcheck")
    intersection() {
        union() { for (t = [5:5:90]) lid(t); }
        union() { base(); body_full(); }
    }
// 검증용 : **앉은 실물 프리즘**이 본체를 파고드는지. 비어 있어야 한다.
//   포켓을 P_SEAT 만큼 올렸으므로 이게 통과해야 앉는 높이가 성립한다.
else if (PART == "prismcheck") intersection() { prism_seated(); body_full(); }
// 검증용 : 판을 끼운 플러그가 캐비티에 들어가는지. **비어 있어야 정상.**
else if (PART == "plugcheck")
    intersection() { on_arm(-1, ARM_I) slit_assy(); body_full(); }
// 검증용 : 슬릿판이 플러그 홈에 들어가는지. **비어 있어야 정상.**
else if (PART == "platecheck")
    intersection() { slit_plug(); translate([0, 0, PLATE_CLR/2]) slit_plate(); }
// 검증용 : 플러그 안에서 **LED → 유산지 → 날(슬릿) → 광창** 이 실제로 뚫려 있는지.
//   슬릿 자리를 지나는 가는 기둥과 플러그의 교집합 — **비어 있어야 정상**이다.
//   2026-09-04 에 여기가 0.925 mm 막혀 있었다. 렌더도 thincheck 도 통과하던 버그다.
else if (PART == "raycheck")
    intersection() {
        slit_assy();
        translate([0, 0, (0.2 + LED_Z - 0.2)/2])
            cube([0.15, CH_Y - 1, LED_Z - 0.4], center = true);   // ★ 어떤 쓸 만한 슬릿보다도 좁게
    }
else if (PART == "thincheck") thincheck();
else                          preview();
